#include <iostream>
using namespace std;

float average(float a, float b)
{
    return (a + b) / 2;
}
float average(float a, float b, float c)
{
    return (a + b + c) / 3;
}
int main()
{
    float a, b, c;

    cout << "Enter two numbers: ";
    cin >> a >> b;
    cout << "Average of two numbers = " << average(a, b) ;

    cout << "\nEnter three numbers: ";
    cin >> a >> b >> c;
    cout << "Average of three numbers = " << average(a, b, c) ;

    return 0;
}
